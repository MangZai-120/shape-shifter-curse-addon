{
    "type": "apoli:multiple",
    "charging_state": {
        "type": "apoli:resource",
        "min": 0,
        "max": 1,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "charge_timer": {
        "type": "apoli:resource",
        "min": 0,
        "max": 20,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "key_activation": {
        "type": "my_addon:fail_aware_active_self",
        "key": {
            "key": "key.ssc_addon.sp_primary"
        },
        "cooldown": 400,
        "fail_cooldown": 200,
        "cooldown_start": "on_end",
        "defer_release": true,
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "my_addon:skill_begin",
                    "power": "my_addon:form_fallen_allay_sp_active_vex_key_activation"
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charging_state",
                    "change": 1,
                    "operation": "set"
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charge_timer",
                    "change": 0,
                    "operation": "set"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "playsound entity.warden.heartbeat hostile @a ~ ~ ~ 1.5 0.5"
                },
                {
                    "type": "apoli:apply_effect",
                    "effect": {
                        "effect": "minecraft:slowness",
                        "duration": 25,
                        "amplifier": 0,
                        "is_ambient": true,
                        "show_particles": false,
                        "show_icon": false
                    }
                }
            ]
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_charging_state",
            "comparison": "==",
            "compare_to": 0
        }
    },
    "tick_charging": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_charging_state",
            "comparison": "==",
            "compare_to": 1
        },
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "*:*_charge_timer",
            "change": 1,
            "operation": "add"
        }
    },
    "charging_particles": {
        "type": "apoli:action_over_time",
        "interval": 4,
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_charging_state",
            "comparison": "==",
            "compare_to": 1
        },
        "entity_action": {
            "type": "my_addon:self_decoration",
            "entity_action": {
                "type": "apoli:execute_command",
                "command": "particle minecraft:smoke ~ ~1 ~ 0.2 0.3 0.2 0.02 6 force @a"
            }
        }
    },
    "trigger_vex": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_charge_timer",
            "comparison": ">=",
            "compare_to": 20
        },
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charging_state",
                    "change": 0,
                    "operation": "set"
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charge_timer",
                    "change": 0,
                    "operation": "set"
                },
                {
                    "type": "apoli:clear_effect",
                    "effect": "minecraft:slowness"
                },
                {
                    "type": "my_addon:summon_fallen_allay_vex"
                },
                {
                    "type": "apoli:execute_command",
                    "command": "playsound entity.evoker.prepare_summon hostile @a ~ ~ ~ 1.5 1.0"
                },
                {
                    "type": "my_addon:self_decoration",
                    "entity_action": {
                        "type": "apoli:execute_command",
                        "command": "particle minecraft:smoke ~ ~1 ~ 0.5 0.5 0.5 0.05 20 force @a"
                    }
                },
                {
                    "type": "my_addon:self_decoration",
                    "entity_action": {
                        "type": "apoli:execute_command",
                        "command": "particle minecraft:large_smoke ~ ~1 ~ 0.3 0.3 0.3 0.02 10 force @a"
                    }
                }
            ]
        }
    },
    "interrupt_on_damage": {
        "type": "apoli:action_when_damage_taken",
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_charging_state",
            "comparison": "==",
            "compare_to": 1
        },
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charging_state",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charge_timer",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "my_addon:skill_failed",
                    "power": "my_addon:form_fallen_allay_sp_active_vex_key_activation"
                },
                {
                    "type": "apoli:clear_effect",
                    "effect": "minecraft:slowness"
                },
                {
                    "type": "apoli:play_sound",
                    "sound": "block.beacon.deactivate",
                    "volume": 0.5,
                    "pitch": 1.5
                }
            ]
        }
    },
    "interrupt_on_purified": {
        "type": "apoli:action_over_time",
        "interval": 1,
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "*:*_charging_state",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "apoli:status_effect",
                    "effect": "ssc_addon:purified"
                }
            ]
        },
        "entity_action": {
            "type": "apoli:and",
            "actions": [
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charging_state",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "apoli:change_resource",
                    "resource": "*:*_charge_timer",
                    "operation": "set",
                    "change": 0
                },
                {
                    "type": "my_addon:skill_failed",
                    "power": "my_addon:form_fallen_allay_sp_active_vex_key_activation"
                },
                {
                    "type": "apoli:clear_effect",
                    "effect": "minecraft:slowness"
                },
                {
                    "type": "apoli:play_sound",
                    "sound": "block.beacon.deactivate",
                    "volume": 0.5,
                    "pitch": 1.5
                }
            ]
        }
    },
    "vex_watchdog": {
        "type": "apoli:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "my_addon:fallen_allay_vex_watchdog"
        }
    }
}

{
    "type": "apoli:action_over_time",
    "interval": 20,
    "entity_action": {
        "type": "apoli:if_else",
        "condition": {
            "type": "apoli:power",
            "power": "shape-shifter-curse:perks/axolotl_vegetation"
        },
        "if_action": {
            "type": "apoli:gain_air",
            "value": -1
        },
        "else_action": {
            "type": "apoli:gain_air",
            "value": -3
        }
    },
    "condition": {
        "type": "apoli:and",
        "conditions": [
            { "type": "apoli:on_block" },
            { "type": "apoli:submerged_in", "fluid": "water", "inverted": true },
            { "type": "apoli:in_rain", "inverted": true }
        ]
    },
    "name": "power.my_addon.form_axolotl_fluorescent_moisture_drain.name",
    "description": "power.my_addon.form_axolotl_fluorescent_moisture_drain.description"
}

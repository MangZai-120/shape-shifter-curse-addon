{
    "type": "apoli:multiple",
    "vortex_state": {
        "type": "apoli:resource",
        "min": 0,
        "max": 80,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "hit_invuln_timer": {
        "type": "apoli:resource",
        "min": 0,
        "max": 18,
        "start_value": 0,
        "hud_render": {
            "should_render": false
        }
    },
    "invuln_timer_tick": {
        "type": "apoli:action_over_time",

        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_hit_invuln_timer",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "vortex_invuln_set": {
        "type": "apoli:action_when_damage_taken",
        "entity_action": {
            "type": "apoli:change_resource",
            "resource": "*:*_hit_invuln_timer",
            "operation": "set",
            "change": 18
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_vortex_state",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "vortex_invuln_block": {
        "type": "apoli:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total",
            "value": -1.0
        },
        "condition": {
            "type": "apoli:and",
            "conditions": [
                {
                    "type": "apoli:resource",
                    "resource": "*:*_vortex_state",
                    "comparison": ">",
                    "compare_to": 0
                },
                {
                    "type": "apoli:resource",
                    "resource": "*:*_hit_invuln_timer",
                    "comparison": ">",
                    "compare_to": 0
                }
            ]
        }
    },
    "damage_reduction_active": {
        "type": "apoli:modify_damage_taken",
        "modifier": {
            "operation": "multiply_total",
            "value": -0.5
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_vortex_state",
            "comparison": ">",
            "compare_to": 0
        }
    },
    "knockback_immunity": {
        "type": "apoli:action_when_damage_taken",
        "entity_action": {
            "type": "apoli:add_velocity",
            "y": 0,
            "set": true
        },
        "condition": {
            "type": "apoli:resource",
            "resource": "*:*_vortex_state",
            "comparison": ">",
            "compare_to": 0

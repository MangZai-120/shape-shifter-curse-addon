{
  "schemaVersion": 1,
  "id": "ssc_addon",
  "provides": [
    "ssc-addon"
  ],
  "version": "${version}",
  "name": "Shape Shifter Curse Addon",
  "description": "Enhances existing forms and expands gameplay.",
  "authors": [
    {
      "name": "MangZai-120",
      "contact": {
        "github": "https://github.com/MangZai-120"
      }
    }
  ],
  "contact": {
    "modrinth": "https://modrinth.com/mod/shape-shifter-curse-addon",
    "curseforge": "https://www.curseforge.com/minecraft/mc-mods/shape-shifter-curse-addon",
    "homepage": "https://shape-shifter-curse-addon.readthedocs.io/zh-cn/latest/",
    "sources": "https://github.com/MangZai-120/shape-shifter-curse-addon",
    "issues": "https://github.com/MangZai-120/shape-shifter-curse-addon/issues"
  },
  "license": "AGPL-3.0-or-later",
  "icon": "assets/ssc_addon/icon.png",
  "environment": "*",
  "entrypoints": {
    "preLaunch": [
      "net.onixary.shapeShifterCurseFabric.ssc_addon.SscAddonPreLaunch"
    ],
    "main": [
      "net.onixary.shapeShifterCurseFabric.ssc_addon.SscAddon"
    ],
    "client": [
      "net.onixary.shapeShifterCurseFabric.ssc_addon.client.SscAddonClient"
    ],
    "modmenu": [
      "net.onixary.shapeShifterCurseFabric.ssc_addon.compat.ModMenuIntegration"
    ],
    "rei_client": [
      "net.jackcooper.shapeShifterCurseAddon.compat.rei.SSCA_REIPlugin"
    ],
    "jei_mod_plugin": [
      "net.jackcooper.shapeShifterCurseAddon.compat.jei.SSCA_JEIPlugin"
    ],
    "emi": [
      "net.jackcooper.shapeShifterCurseAddon.compat.emi.SSCA_EMIPlugin"
    ],
    "cardinal-components-entity": [
      "net.onixary.shapeShifterCurseFabric.ssc_addon.evolution.RegEvolutionComponent",
      "net.jackcooper.shapeShifterCurseAddon.state.RegSpiderMoonWeaverStateComponent"
    ]
  },
  "mixins": [
    "my_addon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric": ">=0.83.0",
    "shape-shifter-curse": ">=1.10.0",
    "geckolib": ">=4.8.4"
  },
  "suggests": {
    "trinkets": ">=3.7.2",
    "modmenu": "*",
    "lambdynlights": "*",
    "asyncparticles": "*"
  },
  "contributors": [
    {
      "name": "wuhenqiubai",
      "contact": {
        "github": "https://github.com/wuhenqiubai"
      }
    }
  ],
  "custom": {
    "cardinal-components": [
      "ssc_addon:evolution",
      "ssc_addon:spider_moon_weaver_state"
    ]
  }
}
